# inventory-service — local environment contract (ETAPA-02/I-05)
# Copy to .env (gitignored) and adjust. All values are DEV-ONLY dummies.
# Compose (Etapa-03) overrides the localhost values with container DNS.

# --- Service ------------------------------------------------------------------
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=dev

# --- Upstream services --------------------------------------------------------
# Host-dev default: the Config Server on this machine. Compose replaces the
# localhost loopback with the container DNS name `config-service`.
CONFIG_URI=http://localhost:8888
# Host-dev default: Eureka on this machine. Compose replaces the localhost
# loopback with the container DNS name `discovery-service`.
EUREKA_URI=http://localhost:8761/eureka/

# --- Datasource (Postgres) ----------------------------------------------------
# Host-dev default: the local Postgres. Compose replaces the localhost loopback
# with the container DNS name `postgres-inventory`.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/inventory_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# --- RabbitMQ (Spring Cloud Bus) ----------------------------------------------
# Host-dev default: the local broker. Compose replaces the localhost loopback
# with the container DNS name `rabbitmq`. The values match the dev broker
# credentials (RABBITMQ_DEFAULT_USER/PASS in the infra contract); the inline
# YAML fallback stays `guest`, which is loopback-only.
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=elara
SPRING_RABBITMQ_PASSWORD=elara

# --- Vault --------------------------------------------------------------------
# Host-dev default: the local Vault dev server. Compose replaces the localhost
# loopback with the container DNS name `vault`.
VAULT_URI=http://localhost:8200
VAULT_TOKEN=00000000-0000-0000-0000-000000000000
